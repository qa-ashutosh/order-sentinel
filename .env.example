# ─────────────────────────────────────────────────────────────────────────────
# order-sentinel — Environment Configuration
# Copy to .env and fill in values for local development.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Under Test ────────────────────────────────────────────────────────────
# URL of the OMS service being tested
API_BASE_URL=http://localhost:3000
API_TIMEOUT_MS=10000

# Optional: API key if the service requires authentication
# API_KEY=your-api-key-here

# ── Message Broker ────────────────────────────────────────────────────────────
# Which broker adapter to use: nats | kafka | rabbitmq
BROKER_TYPE=nats

# NATS
NATS_URL=nats://localhost:4222

# Kafka (if using kafka adapter)
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=order-sentinel-qa
# KAFKA_GROUP_ID=order-sentinel-test-group

# RabbitMQ (if using rabbitmq adapter)
# RABBITMQ_URL=amqp://localhost:5672

# Broker connection timeout in milliseconds
BROKER_TIMEOUT_MS=10000

# ── Database ──────────────────────────────────────────────────────────────────
# Used for direct DB assertions in tests
DB_HOST=localhost
DB_PORT=5432
DB_NAME=order_sentinel_test
DB_USER=sentinel
DB_PASSWORD=sentinel_secret
DB_MAX_CONNECTIONS=10
DB_SSL=false

# ── Testcontainers ────────────────────────────────────────────────────────────
# Set to true to reuse containers between runs (faster local dev)
# TESTCONTAINERS_REUSE_ENABLE=true

# Set to true if Ryuk (container cleanup) causes issues in your environment
# TESTCONTAINERS_RYUK_DISABLED=false
