{
  "name": "order-sentinel",
  "version": "1.0.0",
  "description": "Production-grade QA framework for Order & Profile Management Systems in prop trading.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run tests/api",
    "test:integration": "vitest run tests/integration",
    "test:trading": "vitest run tests/trading-logic",
    "test:contracts": "vitest run tests/contracts",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=verbose --reporter=junit --outputFile.junit=test-results/junit.xml",
    "migrate": "npx tsx migrations/runner.ts up",
    "migrate:down": "npx tsx migrations/runner.ts down",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down -v",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "mock": "tsx mock/server.ts",
    "mock:start": "tsx mock/server.ts &"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.4",
    "@testcontainers/postgresql": "^11.14.0",
    "axios": "^1.7.7",
    "fastify": "^5.8.5",
    "nats": "^2.28.2",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.9.1",
    "testcontainers": "^11.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": {
    "name": "Ashutosh Parihar",
    "email": "qa.ashutosh3@gmail.com",
    "url": "https://github.com/qa-ashutosh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qa-ashutosh/order-sentinel.git"
  },
  "keywords": [
    "qa",
    "testing",
    "prop-trading",
    "oms",
    "nats",
    "fastify",
    "vitest",
    "typescript"
  ],
  "license": "MIT"
}